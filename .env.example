# =============================================================================
# PaySwitch Credit Scoring — Frontend Environment Variables
# =============================================================================
# Copy this file to `.env.local` and fill in real values for your environment.
# Every variable that needs to reach the browser MUST be prefixed NEXT_PUBLIC_.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend API
# -----------------------------------------------------------------------------
# Base URL of the credit-scoring backend API. No trailing slash.
# Local dev:   http://localhost:3001/api
# Staging:     https://<staging-host>
# Production:  https://<prod-host>
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# -----------------------------------------------------------------------------
# Session encryption
# -----------------------------------------------------------------------------
# 64+ character hex string used to AES-encrypt the session cookie payload on
# the client. MUST be set to a strong, environment-specific secret in any
# non-local deployment. Generate with:
#   openssl rand -hex 64
#
# NOTE: this secret is shipped to the browser and provides only obfuscation
# (see docs/security.md). The hard auth boundary is the backend's signed JWT.
NEXT_PUBLIC_SESSION_SECRET=replace-with-openssl-rand-hex-64

# -----------------------------------------------------------------------------
# Mock authentication (development only)
# -----------------------------------------------------------------------------
# When `true`, the login screen bypasses the backend and seeds a mock session
# so the UI can be exercised standalone. MUST be `false` (or unset) in any
# deployed environment.
#
#   - Email containing "admin" → admin portal session
#   - Any other email          → org portal session
#   - Email containing "2fa"   → 2FA challenge is simulated
NEXT_PUBLIC_MOCK_AUTH=false
