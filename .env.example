# =============================================================================
# PaySwitch Credit Scoring — Frontend Environment Variables
# =============================================================================
# Copy this file to `.env.local` for local development. Both variables below
# are SERVER-ONLY — neither reaches the browser, so neither needs to be baked
# into the build. Set them at runtime on whatever platform you deploy to.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend API
# -----------------------------------------------------------------------------
# Base URL of the credit-scoring backend API. Read SERVER-SIDE only by:
#   - the Next Route Handlers under src/app/api/auth/*
#   - the catch-all proxy at src/app/api/proxy/[...path]/route.ts
#
# The browser only ever talks to /api/* on this Next app — never to the
# backend directly. No CORS configuration is required on the backend for the
# FE origin.
#
# Local dev:    http://localhost:3001
# Staging/Prod: https://<host>   (no trailing slash)
BACKEND_API_URL=http://localhost:3001
